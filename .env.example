# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Every integration is optional; missing ones are skipped so forms keep working.

NEXT_PUBLIC_SITE_URL=https://careers.kweastidaho.com
# Turn off before launch: hides TODO placeholder blocks (story slots, leader video slot, review tags)
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
# Debbie's Cal.com / Calendly booking URL (embedded inline on /book, quiz result, final CTA)
NEXT_PUBLIC_BOOKING_URL=

# --- Lead pipeline (server only) ---
# KW Command lead-intake address for this account (confirm with KW tech support)
KW_COMMAND_LEAD_EMAIL=
# ...or a webhook (Zapier / KW integration) that accepts the lead JSON
KW_COMMAND_WEBHOOK_URL=
# Google Sheet backup: Apps Script web app URL + shared secret (see README)
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=
# Email (Resend): owner alerts + auto-email in Debbie's name
RESEND_API_KEY=
LEAD_EMAIL_FROM="Debbie Richards <debbie@careers.kweastidaho.com>"
LEAD_OWNER_EMAIL=justcallDebbie@kw.com
# SMS (Twilio, A2P 10DLC registered): owner alert, speed-to-lead auto-text, event reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
LEAD_OWNER_SMS=+12085907653
# Comma-separated mobiles that get Hot lead pings
HOT_LEAD_SMS_LIST=

# --- Tracking ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Meta Conversions API (server): see docs/event-map.md
META_CAPI_TOKEN=
